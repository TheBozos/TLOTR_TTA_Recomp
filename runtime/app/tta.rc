// The window build's resources on Windows: its icon (The Third Age's variant of The Bozos' logo, docs/branding/make_logo.py tta:
// the clown in a rider's hood under the One Ring; no game art), the UTF-8 manifest and its version information.
#include <winver.h>

1 ICON "tta.ico"
1 24 "tta.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "The Lord of the Rings: The Third Age"
            VALUE "ProductName", "The Lord of the Rings: The Third Age (TLOTR_TTA_Recomp, a native PC port)"
            VALUE "InternalName", "tta"
            VALUE "OriginalFilename", "tta.exe"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
